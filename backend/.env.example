# Copy to .env and fill in. .env is gitignored — never commit real keys.

# YouTube Data API v3 key (server-side only, never exposed to the frontend).
# Create one at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Origin allowed to call this API from a browser (the Vite dev server).
FRONTEND_ORIGIN=http://localhost:5180

# YouTube push notifications (WebSub). PUBLIC_BASE_URL is the app's public https
# origin (the hub calls back to it); the secret is any long random string, e.g.
# `bin/rails secret`. Then run `bin/rails youtube:subscribe`.
PUBLIC_BASE_URL=
YOUTUBE_WEBSUB_SECRET=
